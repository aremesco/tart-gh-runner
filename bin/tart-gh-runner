#!/bin/bash
# One GitHub Actions job, in one throwaway macOS VM, then the VM is destroyed.
#
# Reads its configuration from ~/.config/tart-gh-runner/config (or $CONFIG).
# See tart-gh-runner.conf.example. The README explains why this exists.
set -uo pipefail

CONFIG="${CONFIG:-$HOME/.config/tart-gh-runner/config}"
[ -r "$CONFIG" ] || { echo "no config at $CONFIG — copy tart-gh-runner.conf.example"; exit 78; }
# shellcheck source=/dev/null
. "$CONFIG"

for required in REPO GOLDEN LABELS KEY; do
  [ -n "${!required:-}" ] || { echo "$CONFIG does not set $required"; exit 78; }
done
VM_USER="${VM_USER:-admin}"
VM="ci-$(date +%s)-$$"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/tart-gh-runner}"
SAMPLE_SECONDS="${SAMPLE_SECONDS:-5}"   # 0 disables memory sampling

log() { echo "[$(date -u +%H:%M:%S)] $*"; }
vmssh() {
  ssh -i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=10 "$VM_USER@$IP" "$@"
}

# Memory and swap inside the guest, sampled FROM THE HOST.
#
# A guest that exhausts memory is the case worth measuring, and it is the case
# an in-guest sampler cannot report: the OOM killer takes the sampler along
# with everything else, and the samples immediately before the kill — the only
# ones that show the approach — are the ones lost. So the loop runs over the
# same SSH the supervisor already holds and the host owns the file. If the
# guest dies mid-sample the record simply stops, with everything up to that
# instant already on disk.
#
# One connection, not one per sample. The remote side is POSIX sh and reads
# /proc/meminfo on Linux, sysctl on macOS, so a single supervisor script serves
# both fleets.
SAMPLER_PID=""
sample_memory() {
  mkdir -p "$STATE_DIR/mem"
  local out="$STATE_DIR/mem/$VM.tsv"
  printf 'epoch\tmem_total_mb\tmem_avail_mb\tswap_total_mb\tswap_used_mb\n' > "$out"
  vmssh -o ServerAliveInterval=15 "
    while :; do
      if [ -r /proc/meminfo ]; then
        awk '/^MemTotal:/{t=\$2} /^MemAvailable:/{a=\$2} /^SwapTotal:/{s=\$2} /^SwapFree:/{f=\$2}
             END{printf \"%d\t%d\t%d\t%d\n\", t/1024, a/1024, s/1024, (s-f)/1024}' /proc/meminfo
      else
        sysctl -n hw.memsize vm.swapusage | awk 'NR==1{t=\$1/1048576}
             NR==2{gsub(/M/,\"\"); s=\$3; u=\$6}
             END{printf \"%d\t-1\t%d\t%d\n\", t, s, u}'
      fi
      sleep $SAMPLE_SECONDS
    done" 2>/dev/null \
    | while IFS= read -r line; do printf '%s\t%s\n' "$(date +%s)" "$line" >> "$out"; done &
  SAMPLER_PID=$!
}

# The VM outlives no failure path, including this script being killed.
cleanup() {
  [ -n "$SAMPLER_PID" ] && kill "$SAMPLER_PID" 2>/dev/null
  tart stop "$VM" >/dev/null 2>&1
  sleep 2
  tart delete "$VM" >/dev/null 2>&1
  log "destroyed $VM"
}
trap cleanup EXIT INT TERM

# A registration token is valid for one hour and one registration, so minting
# per job means a leaked one expires on its own.
TOKEN="$(gh api -X POST "repos/$REPO/actions/runners/registration-token" --jq .token 2>/dev/null)"

# STRIPPED, NOT TRUSTED. Run from launchd, `gh` may be unable to reach the
# login keyring and returns {"message":"Requires authentication"} instead of a
# token. Passed on unchecked, that JSON reaches the runner's HTTP client and
# comes back as "New-line characters are not allowed in header values" — a
# message about headers, three layers from the cause. Run this as a LaunchAgent
# in a logged-in session, not a LaunchDaemon; the length check below is the
# backstop for the day that is not true.
RAW_LEN=${#TOKEN}
TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]')"
[ "$RAW_LEN" -eq "${#TOKEN}" ] || log "token carried whitespace (raw $RAW_LEN -> ${#TOKEN}); stripped"
if [ "${#TOKEN}" -lt 20 ]; then
  log "no usable registration token (${#TOKEN} chars) — is gh authenticated with repo admin?"
  exit 1
fi

log "cloning $GOLDEN -> $VM"
tart clone "$GOLDEN" "$VM" || exit 1
# The guest's size is a FLEET decision, made here, never inherited. A clone
# copies the golden's cpu/memory config, and the golden's is whatever the
# image BUILD needed — a rebuild once shipped 8 GB guests onto a fleet sized
# for 4, reserving 64 GB of a 48 GB host, and nothing said so until the host
# was down to 60 MB of free pages. Set explicitly, a rebuild cannot resize
# the fleet.
[ -n "${VM_MEMORY:-}" ] && tart set "$VM" --memory "$VM_MEMORY"
[ -n "${VM_CPU:-}" ] && tart set "$VM" --cpu "$VM_CPU"
tart run "$VM" --no-graphics >/dev/null 2>&1 &

IP=""
for _ in $(seq 1 60); do
  IP="$(tart ip "$VM" 2>/dev/null)"
  [ -n "$IP" ] && break
  sleep 2
done
[ -n "$IP" ] || { log "VM never got an IP"; exit 1; }
log "VM up at $IP"

# Built in a variable and passed as one argument. Wrapping this across lines
# inside quotes put a literal newline into the token argument once already.
CONFIGURE="cd ~/actions-runner && ./config.sh --url https://github.com/$REPO --token $TOKEN --name $VM --labels $LABELS --unattended --ephemeral --replace"

# sshd accepting a connection is not the login environment being ready: an
# attempt three seconds after boot failed where one six seconds later worked.
registered=false
for attempt in 1 2 3 4 5 6; do
  if out="$(vmssh "$CONFIGURE" 2>&1)"; then registered=true; break; fi
  log "registration attempt $attempt: $(printf '%s' "$out" | tail -1)"
  sleep 8
done
[ "$registered" = true ] || { log "registration failed after 6 attempts"; exit 1; }
log "registered $VM, waiting for one job"

# After registration, so the samples cover the job rather than the boot. The
# runner's own name IS $VM, which is what GitHub reports as `runner_name` on
# every job — so this file joins to a job with no correlation step.
if [ "$SAMPLE_SECONDS" -gt 0 ]; then
  sample_memory
  log "sampling guest memory every ${SAMPLE_SECONDS}s -> $STATE_DIR/mem/$VM.tsv"
fi

# --ephemeral means run.sh returns after exactly one job, and the runner
# de-registers itself. Returning is the signal for the supervisor to start the
# next VM.
vmssh 'cd ~/actions-runner && ./run.sh'
log "job finished"
